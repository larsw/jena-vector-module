## Fuseki configuration rendered by docker/entrypoint.sh from environment variables at container start.
## Mount your own file and set FUSEKI_CONFIG to its path to replace it.

PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>
PREFIX vec:    <http://jena.apache.org/vector#>
PREFIX :       <urn:jena-vector:docker#>

:service a fuseki:Service ;
    fuseki:name "@DATASET_NAME@" ;
    ## Unnamed endpoints answer at /<dataset> itself; the named ones are the usual Fuseki URLs.
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ] ;
    fuseki:dataset :dataset .

:dataset a vec:VectorDataset ;
    vec:dataset   :tdb ;
    vec:index     :index ;
    vec:predicate @VECTOR_PREDICATES@ .

:tdb a tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/@DATASET_NAME@" .

:index a vec:QdrantIndex ;
    vec:host       "@QDRANT_HOST@" ;
    vec:port       @QDRANT_PORT@ ;
    vec:tls        @QDRANT_TLS@ ;
    @QDRANT_API_KEY_LINE@
    vec:collection "@QDRANT_COLLECTION@" ;
    vec:dimension  @VECTOR_DIMENSION@ ;
    vec:metric     "@VECTOR_METRIC@" .
